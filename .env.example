# ---- local dev defaults (everything optional; sensible fallbacks) ----
DM_FAKE_LLM=1
DM_LOCAL_FS_ROOT=./local_workspace
DM_DATABASE_URL=duckdb:///./dm_dev.duckdb
DM_DEV_USER=maker@local.dev
DM_MAKER_EMAILS=maker@local.dev
# ---- Free Edition / platform (set in the App's environment) ----
# DM_LAKEBASE_INSTANCE=dm-agent-db        # Lakebase instance name -> auto-credential
# DM_FILES_VOLUME=/Volumes/workspace/dm_agent/files
# DM_LOCAL_FS_ROOT=                       # unset -> volume branch
# DM_FAKE_LLM=0
# DM_MODEL_FRONTIER=<model from your Playground list>
# MLFLOW_EXPERIMENT=/Users/<you>/dm-agent-free
# DM_THINKING_BUDGET=4096                 # try after basics work; remove on 400
# ---- local REAL calls to a workspace endpoint (optional) ----
# DM_DATABRICKS_HOST=https://<workspace-host>
# DM_DATABRICKS_TOKEN=<personal access token>
